{
  "$schema": "./kanit.schema.json",
  "version": "1.0",
  "github": {
    "owner": "aliefe04",
    "repo": "kanit",
    "tokenEnv": "GITHUB_TOKEN"
  },
  "aws": {
    "region": "us-east-1",
    "profile": "default"
  },
  "thresholds": {
    "minScore": 80,
    "failOnSeverity": "CRITICAL"
  },
  "reporting": {
    "outputDir": "./reports",
    "formats": ["terminal", "json"]
  }
}
